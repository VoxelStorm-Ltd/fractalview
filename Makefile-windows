SOURCES=$(wildcard *.cpp)
OBJECTS=$(SOURCES:.cpp=.o)

BIN_DIR=bin
DEP_DIR=deps
BIN=$(BIN_DIR)/fractalview.exe

CPPC = g++
SHARED_ARGS=-std=gnu++0x -Ofast -g -ggdb -mmmx -msse -msse2 -m3dnow -fexceptions -Wall -Wpedantic -static -static-libgcc -static-libstdc++ -DDEBUG -DGLEW_STATIC
COMPILE_ARGS=-c $(SHARED_ARGS)
LINK_ARGS=$(SHARED_ARGS)
LIBS=-Llib/win32 -lglew32 -lglfw3 -lopengl32 -lgdi32 -lglu32 -lwinmm
INCLUDE=-I. -Iinclude

$(BIN): $(OBJECTS) Makefile $(BIN_DIR)
	$(CPPC) $(LINK_ARGS) $(OBJECTS) $(LIBS) -o $(BIN)

$(DEP_DIR):
	mkdir $(DEP_DIR)

$(BIN_DIR):
	mkdir $(BIN_DIR)

%.o: %.cpp Makefile $(DEP_DIR)
	$(CPPC) $(COMPILE_ARGS) $(INCLUDE) $< -MMD -MF $(DEP_DIR)/$(patsubst %.o,%.md,$@)

run: $(BIN)
	./$(BIN)

valg: $(BIN)
	valgrind --leak-check=full $(BIN)

include $(wildcard $(DEP_DIR)/*.md)

clean:
	rm $(BIN) $(OBJECTS); true

